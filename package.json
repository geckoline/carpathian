{
  "name": "carpathian-citizen-science-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch:scholar": "node scripts/fetch-scholar-expert.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "lighthouse:audit": "lighthouse http://localhost:4173 --output=html --output-path=./reports/lighthouse.html --view --preset=desktop",
    "perf:check": "node scripts/lighthouse-check.mjs",
    "test:data": "vitest run src/services/__tests__/ src/hooks/__tests__/ src/store/__tests__/ src/utils/__tests__/",
    "test:data:watch": "vitest watch src/services/__tests__/ src/hooks/__tests__/ src/store/__tests__/ src/utils/__tests__/"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-virtual": "^3.13.24",
    "dompurify": "^3.4.2",
    "focus-trap-react": "^12.0.1",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "immer": "^10.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-markercluster": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^25.0.0",
    "lighthouse": "^13.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.98.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
